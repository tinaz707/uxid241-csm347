# Disable PHP (and similar) execution in this directory
<IfModule mod_authz_core.c>
    <FilesMatch "\.(?i:php|phtml|php[3-8]|phps|phar|pht)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(?i:php|phtml|php[3-8]|phps|phar|pht)$">
        Order Deny,Allow
        Deny from all
    </FilesMatch>
</IfModule>